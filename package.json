  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@fontsource/vt323": "^5.2.0",
    "phaser": "3.90.0",
    "playwright-core": "^1.56.1",
    "vite": "^6.3.0"
  }
}
